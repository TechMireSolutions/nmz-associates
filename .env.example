# Copy this file to .env.local and fill in your values
# .env.local is git-ignored and never committed

# Gmail account used to SEND contact form emails
GMAIL_USER=nmzassociates@gmail.com

# Gmail App Password (NOT your regular Gmail password)
# How to get one:
#  1. Go to myaccount.google.com → Security
#  2. Enable 2-Step Verification
#  3. Go to Security → App passwords
#  4. Select app: Mail, device: Other → name it "NMZ Website"
#  5. Copy the 16-character password (spaces are ok)
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# Public site URL (used for sitemap, OG tags)
NEXT_PUBLIC_SITE_URL=https://nmzassociates.com
